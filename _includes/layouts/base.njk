<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title or "Site" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="/css/style.css" rel="stylesheet" />
  {% block head %}{% endblock %}
</head>
<body class="min-h-screen flex flex-col">
  {# Sticky header: logo, search, X, Ko-fi. Mobile: search toggle #}
  <header class="sticky top-0 z-50 flex items-center gap-4 md:gap-6 px-4 md:px-6 py-3 md:py-4 bg-white/95 backdrop-blur border-b border-gray-200 shadow-sm">
    <button type="button" id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100" aria-label="Toggle sidebar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <a href="/" class="flex-shrink-0 font-semibold text-2xl text-gray-900 hover:text-gray-700">{{ site.logoTitle or "jpopsub" }}</a>
    <div class="flex-1 flex items-center justify-end gap-3 md:gap-4">
      {# Search: visible on desktop, toggle on mobile #}
      <div id="search-wrap" class="hidden md:block flex-1 max-w-md">
        <form action="/" method="get" class="relative" role="search">
          <label for="header-search" class="sr-only">Search</label>
          <input
            id="header-search"
            type="search"
            name="q"
            placeholder="Search…"
            class="w-full rounded-full border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 placeholder-gray-500 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 focus:outline-none"
          />
        </form>
      </div>
      <button type="button" id="search-toggle" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 aria-label="Toggle search">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>

      <a href="{{ site.socialX or 'https://x.com' }}" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg text-gray-600 hover:bg-gray-100 hover:text-gray-900" aria-label="X (Twitter)">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="{{ site.koFi or 'https://ko-fi.com' }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-3 py-2 text-sm font-medium text-white hover:bg-amber-600">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.414 2.586 2.414s8.267-.023 11.94-.028c2.765-.003 5.036-2.662 5.036-2.662s2.893-2.358 2.893-4.57c-.001-.003.065-5.185-.879-7.191z"/></svg>
        Donate
      </a>
    </div>
  </header>

  {# Mobile search panel (toggle) #}
  <div id="search-panel" class="hidden md:hidden border-b border-gray-200 bg-gray-50 px-4 py-3">
    <form action="/" method="get" role="search">
      <label for="mobile-search" class="sr-only">Search</label>
      <input
        id="mobile-search"
        type="search"
        name="q"
        placeholder="Search…"
        class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-500 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 focus:outline-none"
      />
    </form>
  </div>

  <div class="flex-1 flex flex-col md:flex-row min-h-0">
    {# Sidebar: nav + about #}
    <aside class="hidden md:flex md:flex-col flex-shrink-0 w-full md:w-64 lg:w-72 border-b md:border-b-0 md:border-r border-gray-200 bg-gray-50/80 md:sticky md:top-14 md:h-[calc(100vh-4rem)] md:overflow-y-auto p-4 md:p-6" id="sidebar">
      <section class="text-sm text-gray-600">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">About</h2>
        <p>{{ site.about or "This is a placeholder about section. You can edit this in your site data or in the layout." }}</p>
      </section>

      <nav class="mb-6" aria-label="Main">

        <div class="mt-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Tags</h3>
            <a href="/tag" class="text-xs font-medium text-sky-600 hover:text-sky-800">All</a>
          </div>

          <ul class="flex flex-wrap gap-1">
            {% for tag in collections.tagList | sortBy("count") | reverse | take(10) %}
            <li>
              <a href="/tag/{{ tag.slug }}/" class="inline-block rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-200" title="{{ tag.count }} posts">{{ tag.name }}</a>
            </li>
            {% endfor %}
          </ul>
        </div>

        <div class="mt-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Artists</h3>
            <a href="/artist" class="text-xs font-medium text-sky-600 hover:text-sky-800">All</a>
          </div>

          <ul class="space-y-1">
            {% for artist in collections.artists | sortBy("count") | reverse | take(10) %}
            <li>
              <a href="/artist/{{ artist.slug }}/" class="block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-100" title="{{ artist.count }} posts">
                {{ artist.name }}
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </nav>
    </aside>

    {# Main content #}
    <main class="flex-1 overflow-auto p-4 md:p-6 lg:p-8">
      {% block content %}
      {{ content | safe }}
      {% endblock %}
    </main>
  </div>

  <script>
    (function () {
      // Search toggle
      var searchToggle = document.getElementById('search-toggle');
      var searchPanel = document.getElementById('search-panel');
      if (searchToggle && searchPanel) {
        searchToggle.addEventListener('click', function () {
          searchPanel.classList.toggle('hidden');
        });
      }

      // Sidebar toggle - only on mobile
      var sidebarToggle = document.getElementById('sidebar-toggle');
      var sidebar = document.getElementById('sidebar');
      if (sidebarToggle && sidebar) {
        sidebarToggle.addEventListener('click', function () {
          sidebar.classList.toggle('hidden');
        });
      }
    })();
  </script>
  {% block scripts %}{% endblock %}
</body>
</html>
