{% extends "layouts/base.njk" %}

{% block head %}
  {% set pageUrl = page.url %}
  {% if site.url %}
    {% set pageUrl = site.url ~ page.url %}
  {% endif %}
  {% set description = content | excerpt(160) %}
  {% if title %}
  <meta name="description" content="{{ description }}" />
  {% endif %}
  {% set keywords = [] %}
  {% if tags %}
    {% for tag in tags %}
      {% set keywords = keywords | push(tag) %}
    {% endfor %}
  {% endif %}
  {% if category %}
    {% if category is string %}
      {% set cats = [category] %}
    {% else %}
      {% set cats = category %}
    {% endif %}
    {% for cat in cats %}
      {% if cat is string %}
        {% set keywords = keywords | push(cat) %}
      {% else %}
        {% set keywords = keywords | push(cat.name or cat) %}
      {% endif %}
    {% endfor %}
  {% endif %}
  
  {% if keywords.length %}
  <meta name="keywords" content="{{ keywords | join(', ') }}" />
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title or 'Site' }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:type" content="{% if videoID %}video.other{% else %}article{% endif %}" />
  <meta property="og:url" content="{{ pageUrl }}" />
  {% if videoID %}
  <meta property="og:image" content="https://img.youtube.com/vi/{{ videoID }}/maxresdefault.jpg" />
  <meta property="og:video" content="https://www.youtube.com/embed/{{ videoID }}" />
  <meta property="og:video:secure_url" content="https://www.youtube.com/embed/{{ videoID }}" />
  <meta property="og:video:type" content="text/html" />
  <meta property="og:video:width" content="1280" />
  <meta property="og:video:height" content="720" />
  {% endif %}
  <meta property="og:site_name" content="{{ site.title or 'Site' }}" />

  <link rel="canonical" href="{{ pageUrl }}" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="{% if videoID %}player{% else %}summary_large_image{% endif %}" />
  <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title or 'Site' }}" />
  <meta name="twitter:description" content="{{ description }}" />
  {% if videoID %}
  <meta name="twitter:image" content="https://img.youtube.com/vi/{{ videoID }}/maxresdefault.jpg" />
  <meta name="twitter:player" content="https://www.youtube.com/embed/{{ videoID }}" />
  <meta name="twitter:player:width" content="1280" />
  <meta name="twitter:player:height" content="720" />
  {% endif %}

  {% if videoID %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": {{ title | dump }},
    "description": {{ description | dump }},
    "thumbnailUrl": ["https://img.youtube.com/vi/{{ videoID }}/maxresdefault.jpg"],
    "embedUrl": "https://www.youtube.com/embed/{{ videoID }}",
    "contentUrl": "https://www.youtube.com/watch?v={{ videoID }}",
    "url": {{ pageUrl | dump }}{% if date %},
    "uploadDate": "{{ date | htmlDateString }}"{% endif %}
  }
  </script>
  <link rel="stylesheet" href="https://cdn.plyr.io/3.8.4/plyr.css" />
  <style>
    .player-wrapper {
      position: relative;
      width: 100%;
      max-width: 800px;
    }

    /* Plyr YouTube embed needs this class for responsive ratio */
    .plyr__video-embed { width: 100%; }

    #subtitle-overlay {
      position: absolute;
      bottom: 10px; 
      left: 50%;
      transform: translateX(-50%);
      width: 90%;
      text-align: center;
      pointer-events: none;
      z-index: 10;
      transition: bottom 0.5s ease-in-out 0s;
    }
    #subtitle-overlay.control-on {
        bottom: 50px; /* above the Plyr controls bar */
    }
    #subtitle-text {
      display: inline-block;
      background: rgba(0, 0, 0, 0.75);
      color: #fff;
      font-size: 1.1rem;
      padding: 4px 12px;
      border-radius: 4px;
      line-height: 1.5;
      white-space: pre-line; /* preserves multi-line SRT entries */
    }

    #subtitle-text:empty { background: transparent; }
  </style>

  {% endif %}
{% endblock %}

{% block content %}
<article class="max-w-4xl">
  <header class="mb-6 md:mb-8">
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{{ title }}</h1>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
      {% if date %}
      <time datetime="{{ date | htmlDateString }}">{{ date | formatDate }}</time>
      {% endif %}
      {% if tags and tags.length %}
      <span class="flex flex-wrap gap-1.5">
        {% for tag in tags %}
        <a href="/tag/{{ tag | slugify }}/" class="text-gray-600 hover:text-gray-900">{{ tag }}</a>{% if not loop.last %},{% endif %}
        {% endfor %}
      </span>
      {% endif %}
      {% if category %}
      {% if category is string %}
        {% set cats = [category] %}
      {% else %}
        {% set cats = category %}
      {% endif %}
      <span>
        Artist{% if cats.length > 1 %}s{% endif %}:
        {% for cat in cats %}
          {% if cat is string %}
            <a href="/artist/{{ cat | slugify }}/" class="text-gray-600 hover:text-gray-900">{{ cat }}</a>
          {% else %}
            <a href="/artist/{{ (cat.slug or cat.name or cat) | slugify }}/" class="text-gray-600 hover:text-gray-900">{{ cat.name or cat }}</a>
          {% endif %}
          {% if not loop.last %}, {% endif %}
        {% endfor %}
      </span>
      {% endif %}
    </div>
  </header>

  {% if videoID %}
  <div class="player-wrapper mb-6 md:mb-8">
    
    <div id="player" data-plyr-provider="youtube" data-plyr-embed-id="{{ videoID }}"></div>

    <!-- Custom subtitle overlay -->
    <div id="subtitle-overlay">
      <span id="subtitle-text"></span>
    </div>
  </div>
  {% endif %}

  <div class="prose prose-gray max-w-none">
    {{ content | safe }}
  </div>
</article>
{% endblock %}

{% block scripts %}
<script src="https://cdn.plyr.io/3.8.4/plyr.js" ></script>
<script>
  // ─── CONFIG ───────────────────────────────────────────────────────────────
  const SRT_URL = `https://res.cloudinary.com/gahar-co/raw/upload/subtitles/{{ videoID }}.en.srt`;
  // ──────────────────────────────────────────────────────────────────────────

  // Parse SRT text into array of { start, end, text } objects (times in seconds)
  function parseSRT(srt) {
    const cues = [];
    // Normalize line endings
    const blocks = srt.trim().replace(/\r\n/g, '\n').split(/\n\n+/);

    for (const block of blocks) {
      const lines = block.split('\n');
      if (lines.length < 3) continue;

      // lines[0] = index (ignore), lines[1] = timecode, lines[2+] = text
      const timeLine = lines[1];
      const match = timeLine.match(
        /(\d{2}):(\d{2}):(\d{2})[.,](\d{3})\s*-->\s*(\d{2}):(\d{2}):(\d{2})[.,](\d{3})/
      );
      if (!match) continue;

      const toSec = (h, m, s, ms) =>
        parseInt(h) * 3600 + parseInt(m) * 60 + parseInt(s) + parseInt(ms) / 1000;

      cues.push({
        start: toSec(match[1], match[2], match[3], match[4]),
        end:   toSec(match[5], match[6], match[7], match[8]),
        text:  lines.slice(2).join('\n'),
      });
    }

    return cues;
  }

  // Get the subtitle text for a given playback time
  function getActiveCue(cues, time) {
    return cues.find(c => time >= c.start && time <= c.end) || null;
  }

  async function init() {
    // 1. Init Plyr
    const player = new Plyr('#player', {
      captions: { active: false }, // we handle captions manually
      fullscreen: { container: '.player-wrapper'},
      settings: ['quality', 'speed']
    });

    // 2. Fetch + parse the SRT
    let cues = [];
    try {
      const res = await fetch(SRT_URL);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      cues = parseSRT(text);
      console.log(`Loaded ${cues.length} subtitle cues`);
    } catch (err) {
      console.warn('Could not load subtitles:', err);
    }

    // 3. Drive subtitle display from timeupdate
    const subtitleEl = document.getElementById('subtitle-text');

    player.on('timeupdate', () => {
      const cue = getActiveCue(cues, player.currentTime);
      subtitleEl.textContent = cue ? cue.text : '';
    });
    
    const subtitleOverlay = document.getElementById('subtitle-overlay');
    player.on('controlshidden', () => {
      subtitleOverlay.classList.remove('control-on');
    })
    player.on('controlsshown', () => {
      subtitleOverlay.classList.add('control-on');
    })
  }

  init();
</script>
{% endblock %}
