{
  "name": "11ty-tailwind-site",
  "version": "1.0.0",
  "description": "11ty site with Tailwind CSS, YouTube embeds and external subtitles",
  "type": "module",
  "scripts": {
    "build": "ELEVENTY_ENV=production npm run css:build && eleventy",
    "dev": "npm run css:watch & eleventy --serve --incremental",
    "dev2": " npx @11ty/eleventy --serve --incremental",
    "css:build": "tailwindcss -i ./src/css/input.css -o ./src/css/style.css --minify",
    "css:watch": "tailwindcss -i ./src/css/input.css -o ./src/css/style.css --watch",
    "build:all": "npm run css:build && eleventy",
    "dev:all": "npm run css:build && (npm run css:watch & eleventy --serve)"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/typography": "^0.5.10",
    "html-minifier-terser": "^7.2.0",
    "tailwindcss": "^3.4.0"
  }
}
