---
layout: layouts/base.njk
title: Tags
permalink: /tag/index.html
---

<h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 md:mb-8">Tags</h1>
<ul class="flex flex-wrap gap-2">
  {% for tag in collections.tagList | sortBy("name") %}
  <li>
    <a href="/tag/{{ tag.slug }}/" class="inline-block rounded-lg bg-gray-100 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200" title="{{ tag.count }} posts">{{ tag.name }}</a>
  </li>
  {% endfor %}
</ul>
